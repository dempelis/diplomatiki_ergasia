# Copy this file to .env and fill in the values. .env is ignored by git.
# Passwords left empty are generated by `vagrant up` and saved into .env.
# Allowed characters: letters, digits, '.', '_' and '-'.

# MySQL root password, also used to log in to phpMyAdmin as root
MYSQL_ROOT_PASSWORD=

# Database used by the site
DB_NAME=sentiment
DB_USER=sentiment
DB_PASSWORD=

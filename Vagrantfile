# -*- mode: ruby -*-
# vi: set ft=ruby :

# Vagrantfile API/syntax version. Don't touch unless you know what you're doing!
VAGRANTFILE_API_VERSION = "2"

require "securerandom"

# Credentials live in .env (ignored by git), never in the repository.
# Copy .env.example to .env and fill it in; any password left empty is
# generated once and saved back into .env so it stays the same next time.
ENV_FILE = File.join(File.dirname(__FILE__), ".env")
ENV_DEFAULTS = {
  "MYSQL_ROOT_PASSWORD" => nil,
  "DB_NAME"             => "sentiment",
  "DB_USER"             => "sentiment",
  "DB_PASSWORD"         => nil,
}

def load_env_file(path)
  return {} unless File.exist?(path)
  File.readlines(path).each_with_object({}) do |line, vars|
    line = line.strip # also drops Windows \r
    next if line.empty? || line.start_with?("#")
    key, value = line.split("=", 2)
    next if value.nil?
    vars[key.strip] = value.strip.gsub(/\A(["'])(.*)\1\z/, '\2')
  end
end

setup_env = load_env_file(ENV_FILE)
generated = []
ENV_DEFAULTS.each do |key, default|
  next unless setup_env[key].to_s.empty?
  if default
    setup_env[key] = default
  else
    setup_env[key] = SecureRandom.hex(16)
    generated << key
  end
end
unless generated.empty?
  needs_newline = File.exist?(ENV_FILE) && File.size(ENV_FILE) > 0 && !File.read(ENV_FILE).end_with?("\n")
  File.open(ENV_FILE, "a") do |f|
    f.puts if needs_newline
    f.puts "# generated by Vagrantfile on #{Time.now.strftime('%Y-%m-%d')}"
    generated.each { |key| f.puts "#{key}=#{setup_env[key]}" }
  end
  File.chmod(0600, ENV_FILE) rescue nil
  puts "Generated #{generated.join(', ')} and saved to .env"
end

Vagrant.configure(VAGRANTFILE_API_VERSION) do |config|
  # All Vagrant configuration is done here. The most common configuration
  # options are documented and commented below. For a complete reference,
  # please see the online documentation at vagrantup.com.

